# --- Dados (não versionamos o conteúdo bruto; só a estrutura) ---
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Exceção: agregado por UF do Novo Bolsa Família (27 linhas, dado público, sem PII).
# Vem de uma coleta lenta e pautada, em fatias, para preservar a chave do Portal da
# Transparência (scripts/coletar_transparencia_fatias.py) — não é prático refazer essa
# coleta a cada execução do workflow, por isso versionamos o resultado já agregado.
!data/processed/bolsa_familia_por_uf_*.csv

# Exceção: progresso bruto por município dessa mesma coleta (dado público, sem PII;
# consulta por CPF/pessoa não é exposta pela API — só totais por município). É o
# checkpoint que torna a coleta em .github/workflows/coleta-bolsa-familia.yml retomável
# entre execuções do workflow. Um diretório ignorado por `data/raw/*` não deixa `!`
# reincluir arquivos dentro dele — por isso a pasta precisa ser reaberta explicitamente
# antes de reignorar o resto do conteúdo dela.
!data/raw/transparencia/
data/raw/transparencia/*
!data/raw/transparencia/bolsa_familia_*.csv

# --- Figuras e relatórios gerados pelo pipeline (reproduzíveis via scripts/) ---
reports/figures/*
!reports/figures/.gitkeep

# --- Segredos e credenciais ---
.env
.env.*
!.env.example
*.key
secrets.json
credentials.json

# --- Modelos treinados / artefatos pesados (não o código-fonte em src/models/) ---
/models/
*.pkl
*.joblib
*.h5
*.pt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- Sistema operacional / editor ---
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
*:Zone.Identifier
