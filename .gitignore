# --- Dados (não versionamos o conteúdo bruto; só a estrutura) ---
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Figuras e relatórios gerados pelo pipeline (reproduzíveis via scripts/) ---
reports/figures/*
!reports/figures/.gitkeep

# --- Segredos e credenciais ---
.env
.env.*
!.env.example
*.key
secrets.json
credentials.json

# --- Modelos treinados / artefatos pesados (não o código-fonte em src/models/) ---
/models/
*.pkl
*.joblib
*.h5
*.pt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- Sistema operacional / editor ---
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
*:Zone.Identifier
